{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pime.dev/schema/manifest.schema.json",
  "title": "pime plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "abi", "min_core", "runtime", "role", "entry", "platforms"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "min_core": { "type": "string" },
    "state_schema": { "type": "integer", "minimum": 0 },
    "store_schema": { "type": "integer", "minimum": 0 },
    "runtime": { "enum": ["wasm", "lua", "native"] },
    "trusted": { "type": "boolean" },
    "role": {
      "enum": ["parse", "rank", "predict", "punct", "transform", "audio", "ink", "ui", "base", "service"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["windows-x64", "windows-arm64", "macos-x64", "macos-arm64", "linux-x64", "linux-arm64", "android-arm64", "android-x64", "ios-arm64", "ios-x64", "harmony-arm64"] }
    },
    "entry": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+@.+$" }
    },
    "assets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sync_us": { "type": "integer", "minimum": 0 },
        "async_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "hash"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "format": { "type": "string" },
          "engine": { "type": "string" },
          "hash": { "type": "string" },
          "input": { "$ref": "#/$defs/tensors" },
          "output": { "$ref": "#/$defs/tensors" }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string" },
          "type": { "enum": ["bool", "int", "enum", "string"] },
          "default": {},
          "min": { "type": "integer" },
          "max": { "type": "integer" },
          "values": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id"],
      "properties": {
        "alg": { "enum": ["ed25519"] },
        "key_id": { "type": "string" }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_mb": { "type": "integer", "minimum": 1 },
        "instructions": { "type": "integer", "minimum": 1 },
        "time_ms": { "type": "integer", "minimum": 1 },
        "state_kb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "workspace_kb": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "store_mb": { "type": "integer", "minimum": 0 },
        "candidates_max": { "type": "integer", "minimum": 1 },
        "scratch_bytes": { "type": "integer", "minimum": 1024 },
        "max_frame_bytes": { "type": "integer", "minimum": 1024 },
        "net_concurrency": { "type": "integer", "minimum": 0 },
        "net_streams": { "type": "integer", "minimum": 0 },
        "net_bytes": { "type": "integer", "minimum": 0 },
        "net_bandwidth_kbps": { "type": "integer", "minimum": 0 },
        "audio_frames": { "type": "integer", "minimum": 0 },
        "log_bytes_per_sec": { "type": "integer", "minimum": 0 },
        "log_record_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "tensors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dtype", "shape"],
        "properties": {
          "dtype": { "enum": ["f32", "f16", "i8", "u8", "i32"] },
          "shape": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    }
  }
}
